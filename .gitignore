# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Environment / secrets
.env
.env.local
.env.*.local

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project data / outputs
# A pasta inteira: uma campanha passa de gigabytes em JSON de resultado.
/data/outputs/*
!/data/outputs/.gitkeep

# Logs
*.log
logs/

# Models / caches locais
*.bin
*.gguf
.cache/

# Ferramentas locais. Estavam só no .git/info/exclude, invisível para o time.
.claude/worktrees/
.mcp.json
/SETUP.html

# Instruções de agente específicas da máquina
CLAUDE.md

# Documentação: pesada em PDF e CSV, menos o pacote de entrega do artigo
docs/*
!docs/artigo-novo/
