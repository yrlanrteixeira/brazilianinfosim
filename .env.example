# API Keys — copie este arquivo para .env e preencha
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...         # opcional, alternativa

# Modelo LLM a usar
# Opções: claude-haiku-4-5 (barato/rápido), claude-sonnet-4-6 (qualidade)
LLM_MODEL=claude-haiku-4-5

# Banco de dados
DATABASE_URL=sqlite:///data/outputs/simulations.db

# Cache semântico (reduz custo de API)
ENABLE_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.92

# Logs
LOG_LEVEL=INFO
