# Copie este arquivo para .env e ajuste conforme o provedor escolhido.

# ── Provedor de LLM ───────────────────────────────────────────────
# "ollama"    = LLM local via Ollama (default, sem custo de API)
# "anthropic" = API Anthropic (Claude), requer ANTHROPIC_API_KEY
LLM_PROVIDER=ollama

# Modelo a usar. Depende do provider:
#   ollama:    llama3.1:8b | qwen2.5:7b | mistral (precisa ter feito `ollama pull`)
#   anthropic: claude-haiku-4-5 (barato/rápido) | claude-sonnet-4-6 (qualidade)
LLM_MODEL=llama3.1:8b

# ── Ollama (usado quando LLM_PROVIDER=ollama) ─────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Anthropic (usado quando LLM_PROVIDER=anthropic) ───────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Cache de decisões ─────────────────────────────────────────────
# "exact"    = reusa a resposta só quando o prompt é idêntico (default)
# "semantic" = modo do TCC I, por similaridade de cosseno. NÃO usar em
#              campanha nova: o template do prompt domina o embedding e
#              perfis opostos dão hit, colapsando a heterogeneidade dos
#              agentes. Mantido apenas para medir esse artefato.
# "off"      = sem cache, cada decisão é uma chamada nova
CACHE_MODE=exact
ENABLE_CACHE=true
# Só tem efeito quando CACHE_MODE=semantic.
CACHE_SIMILARITY_THRESHOLD=0.92

# ── Banco de dados (reservado) ────────────────────────────────────
DATABASE_URL=sqlite:///data/outputs/simulations.db

# ── Logs ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
